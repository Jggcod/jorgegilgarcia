---
import Section from "@/components/cv_page/Section.astro";
import yearFormat from "@/helpers/yearFormat";

import { work } from "@cv";
---

<Section title="Experience">
  <ul>
    {
      work.map(({ name, startDate, endDate, position, summary, url, highlights }) => {
        const years = yearFormat(startDate, endDate);
        const paragraphs = summary.split("\\n");
        return (
          <li>
            <article>
              <header>
                <div>
                  <a
                    href={url}
                    target="_blank">
                    <h3>{name}</h3>
                  </a>
                  <h4>{position}</h4>
                </div>
                <time>{years}</time>
              </header>
              <footer>
                {paragraphs.map((paragraph) => (
                  <p>{paragraph.trim() ? `- ${paragraph}` : paragraph}</p>
                ))}
                {highlights?.length > 0 && (
                  <div class="tags">
                    {highlights.map((tag) => (
                      <span>{tag}</span>
                    ))}
                  </div>
                )}
              </footer>
            </article>
          </li>
        );
      })
    }
  </ul>
</Section>

<style>
  p {
    text-wrap: pretty;
  }
  ul {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  article h3 {
    font-weight: 500;
    color: #111;
    text-wrap: pretty;
  }
  article a:hover {
    text-decoration: underline;
  }

  article h4 {
    color: #222;
    font-weight: 400;
    text-wrap: pretty;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 4px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-top: 0.5rem;
  }

  .tags span {
    background: #eee;
    border-radius: 6px;
    color: #444;
    font-size: 0.7rem;
    font-weight: 500;
    padding: 0.2rem 0.6rem;
  }

  time {
    color: #555;
    font-size: 0.85rem;
    padding-top: 0.5rem;
  }

  @media (width <= 700px) {
    time {
      text-align: right;
      text-wrap: nowrap;
    }
  }

  /* @media print {
    ul {
      page-break-after: always;
    }
  } */
</style>
